GROQ_API_KEY=

# MongoDB Atlas connection string, e.g. mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/visualmind?retryWrites=true&w=majority
MONGO_URI=

# Any long random string — used to sign login session tokens
JWT_SECRET=

# The deployed frontend's origin, e.g. https://your-app.netlify.app (no trailing slash)
# For local dev this defaults to http://localhost:5173 if left unset.
CLIENT_ORIGIN=

# Set to "production" on Render — enables secure, cross-site cookies (see middleware/auth.js)
NODE_ENV=
